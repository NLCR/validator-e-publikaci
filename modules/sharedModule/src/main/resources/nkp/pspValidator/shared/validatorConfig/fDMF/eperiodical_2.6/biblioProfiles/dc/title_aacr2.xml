                <expectedContent/>

            </element>

            <element name="dc:publisher" mandatory="false">
                <expectedContent/>

            </element>

            <element name="dc:date">
                <expectedContent/>

            </element>

            <element name="dc:language" mandatory="false">
                <expectedContent/>

            </element>

            <element name="dc:format" mandatory="false">
                <expectedContent/>

            </element>

            <element name="dc:description" mandatory="false">
                <expectedContent/>

            </element>

            <element name="dc:subject" mandatory="false">
                <expectedContent/>

            </element>

            <element name="dc:identifier">
                <expectedContent/>

            </element>

            <element name="dc:source" mandatory="false">
                <expectedContent/>

            </element>

        </expectedElements>
    </rootElement>
</metadataProfile>
