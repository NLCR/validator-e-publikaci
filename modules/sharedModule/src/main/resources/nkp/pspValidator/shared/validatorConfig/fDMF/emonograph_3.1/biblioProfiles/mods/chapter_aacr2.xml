<?xml version="1.0" encoding="UTF-8"?>
<metadataProfile
    xmlns="http://www.nkp.cz/validatorEpublikaci/2.4/metadataProfile"
    name="MODS chapter of monographic (AACR2)"
    validatorVersion="2.4"
    dmf="monograph_3.1"
>
    <info>
        <text>DMF Elektronické publikace (monografie) 3.1  očekává MODS verze 3.8. Dále se zde upřesňují očekávaná metadata pro kapitolu monografie pro záznamy zpracované podle katalogizačních pravidel AACR2.</text>
        <url>http://www.loc.gov/standards/mods/</url>
        <url description="XSD pro MODS 3.8">http://www.loc.gov/standards/mods/v3/mods-3-8.xsd</url>
        <url description="Popis MODS">https://www.loc.gov/standards/mods/userguide/</url>
    </info>

    <namespaces>
        <namespace prefix="mods">http://www.loc.gov/mods/v3</namespace>
    </namespaces>

    <dictionaries>
        <dictionary name="marcRelatorCodes"/>
        <dictionary name="iso6392languageCodes"/>
    </dictionaries>

    <rootElement name="mods:mods">
        <expectedAttributes>
            <attribute name="ID">
                <expectedContent>
                    <regexp>^MODS_CHAP_[0-9]{4}$</regexp>

                </expectedContent>

            </attribute>
            <attribute name="version">
                <expectedContent>
                    <value>3.8</value>

                </expectedContent>

            </attribute>
        </expectedAttributes>
        <expectedElements>
            <element name="mods:titleInfo">
                <expectedAttributes>
                    <attribute name="type" mandatory="false">
                        <expectedContent>
                            <oneOf>
                                <value>abbreviated</value>

                                <value>alternative</value>

                                <value>translated</value>

                                <value>uniform</value>

                            </oneOf>
                        </expectedContent>

                    </attribute>
                </expectedAttributes>
                <expectedElements>
                    <element name="mods:nonSort" mandatory="false">
                        <expectedContent/>

                    </element>

                    <element name="mods:title">
                        <expectedContent/>

                    </element>

                    <element name="mods:subTitle" mandatory="false">
                        <expectedContent/>

                    </element>

                    <element name="mods:partNumber" mandatory="false">
                        <recommendedContent/>

                    </element>

                    <element name="mods:partName" mandatory="false">
                        <recommendedContent/>

                    </element>

                </expectedElements>
            </element>

            <element name="mods:name" mandatory="false">
                <expectedAttributes>
                    <attribute name="type" mandatory="false">
                        <expectedContent>
                            <oneOf>
                                <value>personal</value>

                                <value>corporate</value>

                                <value>conference</value>

                                <value>family</value>

                            </oneOf>
                        </expectedContent>

                    </attribute>
                </expectedAttributes>
                <expectedElements>
                    <element name="mods:namePart" mandatory="false" specification="@type='date'">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent/>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:namePart" mandatory="false" specification="@type='family'">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent/>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:namePart" mandatory="false" specification="@type='given'">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent/>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:namePart" mandatory="false" specification="@type='termsOfAddress'">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent/>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:namePart" mandatory="false" specification="not(@type)">
                        <expectedContent/>

                    </element>

                    <element name="mods:alternativeName" mandatory="false">
                        <expectedElements>
                            <element name="mods:namePart">
                                <expectedContent/>

                            </element>

                        </expectedElements>
                    </element>

                    <element name="mods:nameIdentifier" mandatory="false">
                        <expectedAttributes>
                            <attribute name="type" mandatory="false">
                                <expectedContent/>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:etal" mandatory="false" repeatable="false">
                        <expectedContent/>

                    </element>

                    <element name="mods:role" mandatory="false">
                        <expectedElements>
                            <element name="mods:roleTerm">
                                <expectedAttributes>
                                    <attribute name="type">
                                        <expectedContent>
                                            <value>code</value>

                                        </expectedContent>

                                    </attribute>
                                    <attribute name="authority">
                                        <expectedContent>
                                            <value>marcrelator</value>

                                        </expectedContent>

                                    </attribute>
                                </expectedAttributes>
                                <expectedContent>
                                    <fromDictionary name="marcRelatorCodes"/>

                                </expectedContent>

                            </element>

                        </expectedElements>
                    </element>

                </expectedElements>
            </element>

            <element name="mods:genre">
                <expectedAttributes>
                    <attribute name="type" mandatory="false">
                        <recommendedContent>
                            <oneOf>
                                <value>tableOfContents</value>

                                <value>advertisement</value>

                                <value>abstract</value>

                                <value>introduction</value>

                                <value>review</value>

                                <value>dedication</value>

                                <value>bibliography</value>

                                <value>editorsNote</value>

                                <value>preface</value>

                                <value>chapter</value>

                                <value>article</value>

                                <value>index</value>

                                <value>unspecified</value>

                            </oneOf>
                        </recommendedContent>

                    </attribute>
                </expectedAttributes>
                <expectedContent>
                    <value>chapter</value>

                </expectedContent>

            </element>

            <element name="mods:language" mandatory="false">
                <expectedElements>
                    <element name="mods:languageTerm">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent>
                                    <value>code</value>

                                </expectedContent>

                            </attribute>
                            <attribute name="authority">
                                <expectedContent>
                                    <value>iso639-2b</value>

                                </expectedContent>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent>
                            <fromDictionary name="iso6392languageCodes"/>

                        </expectedContent>

                    </element>

                </expectedElements>
            </element>

            <element name="mods:abstract" mandatory="false">
                <expectedContent/>

            </element>

            <element name="mods:note" mandatory="false">
                <recommendedContent/>

            </element>

            <element name="mods:subject" mandatory="false">
                <expectedAttributes>
                    <attribute name="authority" mandatory="false">
                        <recommendedContent/>

                    </attribute>
                </expectedAttributes>
                <expectedElements>
                    <element name="mods:topic" mandatory="false">
                        <expectedAttributes>
                            <attribute name="valueURI" mandatory="false">
                                <recommendedContent/>

                            </attribute>
                        </expectedAttributes>
                        <recommendedContent/>

                    </element>

                    <element name="mods:geographic" mandatory="false">
                        <expectedAttributes>
                            <attribute name="valueURI" mandatory="false">
                                <recommendedContent/>

                            </attribute>
                        </expectedAttributes>
                        <recommendedContent/>

                    </element>

                    <element name="mods:temporal" mandatory="false">
                        <recommendedContent/>

                    </element>

                    <element name="mods:name" mandatory="false">
                        <expectedElements>
                            <element name="mods:namePart">
                                <expectedContent/>

                            </element>

                        </expectedElements>
                    </element>

                </expectedElements>
            </element>

            <element name="mods:classification" mandatory="false">
                <expectedAttributes>
                    <attribute name="authority">
                        <expectedContent>
                            <oneOf>
                                <value>udc</value>

                                <value>Konspekt</value>

                                <value>lcc</value>

                                <value>ddc</value>

                                <value>nlm</value>

                                <value>sudocs</value>

                                <value>candocs</value>

                                <value>contents of $2</value>

                            </oneOf>
                        </expectedContent>

                    </attribute>
                    <attribute name="edition" mandatory="false">
                        <expectedContent>
                            <value>Konspekt</value>

                        </expectedContent>

                    </attribute>
                </expectedAttributes>
                <recommendedContent/>

            </element>

            <element name="mods:identifier" specification="@type = 'uuid'">
                <expectedAttributes>
                    <attribute name="type">
                        <expectedContent/>

                    </attribute>
                </expectedAttributes>
                <expectedContent/>

            </element>

            <element name="mods:identifier" mandatory="false" specification="@type = 'urnnbn'">
                <expectedAttributes>
                    <attribute name="type">
                        <expectedContent/>

                    </attribute>
                </expectedAttributes>
                <expectedContent/>

            </element>

            <element name="mods:identifier" mandatory="false" specification="
  @type
  and not(
    @type = 'uuid'
    or @type = 'urnnbn'
  )
">
                <expectedAttributes>
                    <attribute name="type">
                        <expectedContent/>

                    </attribute>
                </expectedAttributes>
                <recommendedContent/>

            </element>

            <element name="mods:identifier" mandatory="false" specification="not(self::mods:identifier[@type = 'uuid'] or self::mods:identifier[@type = 'urnnbn'] or self::mods:identifier[
  @type
  and not(
    @type = 'uuid'
    or @type = 'urnnbn'
  )
])">
                <expectedAttributes>
                    <attribute name="type">
                        <expectedContent/>

                    </attribute>
                </expectedAttributes>
                <expectedContent/>

            </element>

            <element name="mods:part" mandatory="false" specification="@type='pageNumber'">
                <expectedAttributes>
                    <attribute name="type">
                        <expectedContent>
                            <value>pageNumber</value>

                        </expectedContent>

                    </attribute>
                </expectedAttributes>
                <expectedElements>
                    <element name="mods:detail" mandatory="false">
                        <expectedElements>
                            <element name="mods:number">
                                <expectedContent/>

                            </element>

                        </expectedElements>
                    </element>

                    <element name="mods:extent" mandatory="false">
                        <expectedAttributes>
                            <attribute name="unit">
                                <expectedContent>
                                    <value>pages</value>

                                </expectedContent>

                            </attribute>
                        </expectedAttributes>
                        <expectedElements>
                            <element name="mods:start" mandatory="false">
                                <expectedContent/>

                            </element>

                            <element name="mods:end" mandatory="false">
                                <expectedContent/>

                            </element>

                            <element name="mods:total" mandatory="false">
                                <expectedContent/>

                            </element>

                        </expectedElements>
                    </element>

                </expectedElements>
            </element>

            <element name="mods:part" mandatory="false" specification="@type='pageIndex'">
                <expectedAttributes>
                    <attribute name="type">
                        <expectedContent>
                            <value>pageIndex</value>

                        </expectedContent>

                    </attribute>
                </expectedAttributes>
                <expectedElements>
                    <element name="mods:detail" mandatory="false">
                        <expectedElements>
                            <element name="mods:number">
                                <expectedContent/>

                            </element>

                        </expectedElements>
                    </element>

                    <element name="mods:extent" mandatory="false">
                        <expectedElements>
                            <element name="mods:start" mandatory="false">
                                <expectedContent/>

                            </element>

                            <element name="mods:end" mandatory="false">
                                <expectedContent/>

                            </element>

                        </expectedElements>
                    </element>

                </expectedElements>
            </element>

            <element name="mods:part" mandatory="false" specification="not(self::mods:part[@type='pageNumber'] or self::mods:part[@type='pageIndex'])">
                <expectedAttributes>
                    <attribute name="type">
                        <expectedContent>
                            <oneOf>
                                <value>pageNumber</value>

                                <value>pageIndex</value>

                            </oneOf>
                        </expectedContent>

                    </attribute>
                </expectedAttributes>
                <recommendedContent/>

            </element>

            <element name="mods:recordInfo">
                <expectedElements>
                    <element name="mods:recordContentSource" mandatory="false">
                        <expectedAttributes>
                            <attribute name="authority" mandatory="false">
                                <recommendedContent>
                                    <value>siglaADR</value>

                                </recommendedContent>

                            </attribute>
                        </expectedAttributes>
                        <recommendedContent/>

                    </element>

                    <element name="mods:recordCreationDate">
                        <expectedAttributes>
                            <attribute name="encoding">
                                <expectedContent>
                                    <value>iso8601</value>

                                </expectedContent>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:recordChangeDate" mandatory="false">
                        <expectedAttributes>
                            <attribute name="encoding" mandatory="false">
                                <expectedContent>
                                    <value>iso8601</value>

                                </expectedContent>

                            </attribute>
                        </expectedAttributes>
                        <recommendedContent/>

                    </element>

                    <element name="mods:recordOrigin" mandatory="false">
                        <recommendedContent>
                            <oneOf>
                                <value>machine generated</value>

                                <value>human prepared</value>

                            </oneOf>
                        </recommendedContent>

                    </element>

                </expectedElements>
            </element>

            <element name="mods:physicalDescription">
                <expectedElements>
                    <element name="mods:form">
                        <expectedAttributes>
                            <attribute name="authority" mandatory="false">
                                <expectedContent>
                                    <oneOf>
                                        <value>marcform</value>

                                        <value>marccategory</value>

                                        <value>marcsmd</value>

                                        <value>gmd</value>

                                    </oneOf>
                                </expectedContent>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent>
                            <value>electronic</value>

                        </expectedContent>

                    </element>

                    <element name="mods:digitalOrigin">
                        <expectedContent>
                            <value>born digital</value>

                        </expectedContent>

                    </element>

                </expectedElements>
            </element>

        </expectedElements>
    </rootElement>
</metadataProfile>
