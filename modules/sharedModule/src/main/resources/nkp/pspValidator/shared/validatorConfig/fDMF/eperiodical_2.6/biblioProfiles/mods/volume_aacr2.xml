<?xml version="1.0" encoding="UTF-8"?>
<metadataProfile
    xmlns="http://www.nkp.cz/validatorEpublikaci/2.4/metadataProfile"
    name="MODS volume of periodical (AACR2)"
    validatorVersion="2.4"
    dmf="e-periodical_2.6"
>
    <info>
        <text>DMF Elektronické publikace (periodika) 2.6 očekává MODS verze 3.8. Dále se zde upřesňují očekávaná metadata pro ročník periodika pro záznamy zpracované podle katalogizačních pravidel AACR2.</text>
        <url>http://www.loc.gov/standards/mods/</url>
        <url description="XSD pro MODS 3.8">http://www.loc.gov/standards/mods/v3/mods-3-8.xsd</url>
        <url description="Popis MODS">https://www.loc.gov/standards/mods/userguide/</url>
    </info>

    <namespaces>
        <namespace prefix="mods">http://www.loc.gov/mods/v3</namespace>
    </namespaces>

    <dictionaries>
        <dictionary name="marcRelatorCodes"/>
        <dictionary name="iso6392languageCodes"/>
    </dictionaries>

    <rootElement name="mods:mods">
        <expectedAttributes>
            <attribute name="ID">
                <expectedContent>
                    <value>MODS_VOLUME_0001</value>

                </expectedContent>

            </attribute>
            <attribute name="version">
                <expectedContent>
                    <value>3.8</value>

                </expectedContent>

            </attribute>
        </expectedAttributes>
        <expectedElements>
            <element name="mods:titleInfo">
                <expectedAttributes>
                    <attribute name="type" mandatory="false">
                        <expectedContent>
                            <oneOf>
                                <value>abbreviated</value>

                                <value>alternative</value>

                                <value>translated</value>

                                <value>uniform</value>

                            </oneOf>
                        </expectedContent>

                    </attribute>
                </expectedAttributes>
                <expectedElements>
                    <element name="mods:title" mandatory="false">
                        <expectedContent/>

                    </element>

                    <element name="mods:partNumber" mandatory="false">
                        <expectedContent/>

                    </element>

                </expectedElements>
            </element>

            <element name="mods:name" mandatory="false">
                <expectedAttributes>
                    <attribute name="type" mandatory="false">
                        <expectedContent>
                            <oneOf>
                                <value>personal</value>

                                <value>corporate</value>

                                <value>conference</value>

                                <value>family</value>

                            </oneOf>
                        </expectedContent>

                    </attribute>
                    <attribute name="usage" mandatory="false">
                        <recommendedContent>
                            <value>primary</value>

                        </recommendedContent>

                    </attribute>
                </expectedAttributes>
                <expectedElements>
                    <element name="mods:namePart" mandatory="false" specification="@type='date'">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent/>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:namePart" mandatory="false" specification="@type='family'">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent/>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:namePart" mandatory="false" specification="@type='given'">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent/>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:namePart" mandatory="false" specification="@type='termsOfAddress'">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent/>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:namePart" mandatory="false" specification="not(@type)">
                        <expectedContent/>

                    </element>

                    <element name="mods:alternativeName" mandatory="false">
                        <expectedElements>
                            <element name="mods:namePart">
                                <expectedContent/>

                            </element>

                        </expectedElements>
                    </element>

                    <element name="mods:nameIdentifier" mandatory="false">
                        <expectedContent/>

                    </element>

                    <element name="mods:etal" mandatory="false" repeatable="false">
                        <expectedContent/>

                    </element>

                    <element name="mods:role" mandatory="false">
                        <expectedElements>
                            <element name="mods:roleTerm">
                                <expectedAttributes>
                                    <attribute name="type">
                                        <expectedContent>
                                            <value>code</value>

                                        </expectedContent>

                                    </attribute>
                                    <attribute name="authority">
                                        <expectedContent>
                                            <value>marcrelator</value>

                                        </expectedContent>

                                    </attribute>
                                </expectedAttributes>
                                <expectedContent>
                                    <fromDictionary name="marcRelatorCodes"/>

                                </expectedContent>

                            </element>

                        </expectedElements>
                    </element>

                </expectedElements>
            </element>

            <element name="mods:genre" specification=". = 'volume' or . = 'electronic volume'">
                <expectedContent>
                    <value>electronic volume</value>

                </expectedContent>

            </element>

            <element name="mods:genre" mandatory="false" specification="not(. = 'volume' or . = 'electronic volume')">
                <recommendedContent/>

            </element>

            <element name="mods:originInfo">
                <expectedElements>
                    <element name="mods:dateIssued">
                        <expectedAttributes>
                            <attribute name="point" mandatory="false">
                                <recommendedContent>
                                    <oneOf>
                                        <value>start</value>

                                        <value>end</value>

                                    </oneOf>
                                </recommendedContent>

                            </attribute>
                            <attribute name="qualifier" mandatory="false">
                                <recommendedContent>
                                    <oneOf>
                                        <value>approximate</value>

                                        <value>inferred</value>

                                        <value>questionable</value>

                                    </oneOf>
                                </recommendedContent>

                            </attribute>
                            <attribute name="calendar" mandatory="false">
                                <expectedContent>
                                    <oneOf>
                                        <value>gregorian</value>

                                        <value>hebrew</value>

                                        <value>julian</value>

                                    </oneOf>
                                </expectedContent>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                </expectedElements>
            </element>

            <element name="mods:identifier" specification="@type='uuid'">
                <expectedAttributes>
                    <attribute name="type">
                        <expectedContent/>

                    </attribute>
                </expectedAttributes>
                <expectedContent/>

            </element>

            <element name="mods:identifier" mandatory="false" specification="@type='urnnbn'">
                <expectedAttributes>
                    <attribute name="type">
                        <expectedContent/>

                    </attribute>
                </expectedAttributes>
                <expectedContent/>

            </element>

            <element name="mods:identifier" mandatory="false" specification="
  @type
  and not(
    @type = 'uuid'
    or @type = 'urnnbn'
  )
">
                <expectedAttributes>
                    <attribute name="type">
                        <expectedContent/>

                    </attribute>
                </expectedAttributes>
                <recommendedContent/>

            </element>

            <element name="mods:identifier" mandatory="false" specification="not(self::mods:identifier[@type='uuid'] or self::mods:identifier[@type='urnnbn'] or self::mods:identifier[
  @type
  and not(
    @type = 'uuid'
    or @type = 'urnnbn'
  )
])">
                <expectedAttributes>
                    <attribute name="type">
                        <expectedContent/>

                    </attribute>
                </expectedAttributes>
                <expectedContent/>

            </element>

            <element name="mods:recordInfo">
                <expectedElements>
                    <element name="mods:recordCreationDate">
                        <expectedAttributes>
                            <attribute name="encoding">
                                <expectedContent>
                                    <value>iso8601</value>

                                </expectedContent>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:recordChangeDate" mandatory="false">
                        <expectedAttributes>
                            <attribute name="encoding">
                                <expectedContent>
                                    <value>iso8601</value>

                                </expectedContent>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:recordOrigin" mandatory="false">
                        <recommendedContent>
                            <oneOf>
                                <value>machine generated</value>

                                <value>human prepared</value>

                            </oneOf>
                        </recommendedContent>

                    </element>

                </expectedElements>
            </element>

        </expectedElements>
    </rootElement>
</metadataProfile>
