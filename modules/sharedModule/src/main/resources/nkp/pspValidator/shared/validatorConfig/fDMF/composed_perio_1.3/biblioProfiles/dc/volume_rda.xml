<?xml version="1.0" encoding="UTF-8"?>
<metadataProfile
    xmlns="http://www.nkp.cz/validatorEpublikaci/2.3/metadataProfile"
    name="DC volume of composed periodical (RDA)"
    validatorVersion="2.3"
    dmf="composed-perio_1.3"
>
    <info>
        <text>DMF Elektronické publikace (skládaná periodika) 1.3  očekává DC verze 3.8. Dále se zde upřesňují očekávaná metadata pro ročník periodika pro záznamy zpracované podle katalogizačních pravidel RDA.</text>
        <url description="Popis Dublin Core 1.1">http://dublincore.org/documents/dces/</url>
        <url description="XSD pro Dublin Core 1.1">http://www.openarchives.org/OAI/2.0/oai_dc.xsd</url>
    </info>

    <namespaces>
        <namespace prefix="oai_dc">http://www.openarchives.org/OAI/2.0/oai_dc/</namespace>
        <namespace prefix="dc">http://purl.org/dc/elements/1.1/</namespace>
    </namespaces>

    <dictionaries>
        <dictionary name="marcRelatorCodes"/>
        <dictionary name="iso6392languageCodes"/>
    </dictionaries>

    <rootElement name="oai_dc:dc">
        <expectedElements>
            <element name="dc:title">
                <expectedContent/>

            </element>

            <element name="dc:creator" mandatory="false">
                <expectedContent/>

            </element>

            <element name="dc:type" specification=". = 'model:periodicalvolume'">
                <expectedContent/>

            </element>

            <element name="dc:type" mandatory="false" specification="not(. = 'model:periodicalvolume')">
                <expectedContent/>

            </element>

            <element name="dc:date">
                <expectedContent/>

            </element>

            <element name="dc:identifier">
                <expectedContent/>

            </element>

        </expectedElements>
    </rootElement>
</metadataProfile>
