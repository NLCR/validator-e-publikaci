<?xml version="1.0" encoding="UTF-8"?>
<metadataProfile
    xmlns="http://www.nkp.cz/validatorEpublikaci/2.4/metadataProfile"
    name="DC supplement of composed periodical (AACR2)"
    validatorVersion="2.4"
    dmf="composed-perio_1.3"
>
    <info>
        <text>DMF Elektronické publikace (skládaná periodika) 1.3 očekává MODS verze 3.8. Dále se zde upřesňují očekávaná metadata pro přílohu periodika pro záznamy zpracované podle katalogizačních pravidel AACR2.</text>
        <url>http://www.loc.gov/standards/mods/</url>
        <url description="XSD pro MODS 3.8">http://www.loc.gov/standards/mods/v3/mods-3-8.xsd</url>
        <url description="Popis MODS">https://www.loc.gov/standards/mods/userguide/</url>
    </info>

    <namespaces>
        <namespace prefix="oai_dc">http://www.openarchives.org/OAI/2.0/oai_dc/</namespace>
        <namespace prefix="dc">http://purl.org/dc/elements/1.1/</namespace>
    </namespaces>

    <dictionaries>
        <dictionary name="marcRelatorCodes"/>
        <dictionary name="iso6392languageCodes"/>
    </dictionaries>

    <rootElement name="oai_dc:dc">
        <expectedElements>
            <element name="dc:title">
                <expectedContent/>

            </element>

            <element name="dc:creator" mandatory="false">
                <expectedContent/>

            </element>

            <element name="dc:type" specification=". = 'model:supplement'">
                <expectedContent/>

            </element>

            <element name="dc:type" mandatory="false" specification="not(. = 'model:supplement')">
                <expectedContent/>

            </element>

            <element name="dc:publisher" mandatory="false">
                <expectedContent/>

            </element>

            <element name="dc:date" mandatory="false">
                <expectedContent/>

            </element>

            <element name="dc:language">
                <expectedContent/>

            </element>

            <element name="dc:format" mandatory="false">
                <expectedContent/>

            </element>

            <element name="dc:description" mandatory="false">
                <expectedContent/>

            </element>

            <element name="dc:subject" mandatory="false">
                <expectedContent/>

            </element>

            <element name="dc:identifier">
                <expectedContent/>

            </element>

            <element name="dc:source" mandatory="false">
                <expectedContent/>

            </element>

        </expectedElements>
    </rootElement>
</metadataProfile>
