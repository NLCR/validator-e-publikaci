            <attribute name="version">
                <expectedContent>
                    <value>3.8</value>

                </expectedContent>

            </attribute>
        </expectedAttributes>
        <expectedElements>
            <element name="mods:titleInfo" repeatable="false" specification="not(@otherType='mutational edition')">
