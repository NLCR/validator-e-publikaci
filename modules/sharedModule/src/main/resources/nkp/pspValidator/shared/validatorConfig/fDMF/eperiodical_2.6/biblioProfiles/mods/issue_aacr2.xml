<?xml version="1.0" encoding="UTF-8"?>
<metadataProfile
    xmlns="http://www.nkp.cz/validatorEpublikaci/2.4/metadataProfile"
    name="MODS issue of periodical (AACR2)"
    validatorVersion="2.4"
    dmf="e-periodical_2.6"
>
    <info>
        <text>DMF Elektronické publikace (periodika) 2.6 očekává MODS verze 3.8. Dále se zde upřesňují očekávaná metadata pro číslo periodika pro záznamy zpracované podle katalogizačních pravidel AACR2.</text>
        <url>http://www.loc.gov/standards/mods/</url>
        <url description="XSD pro MODS 3.8">http://www.loc.gov/standards/mods/v3/mods-3-8.xsd</url>
        <url description="Popis MODS">https://www.loc.gov/standards/mods/userguide/</url>
    </info>

    <namespaces>
        <namespace prefix="mods">http://www.loc.gov/mods/v3</namespace>
    </namespaces>

    <dictionaries>
        <dictionary name="marcRelatorCodes"/>
        <dictionary name="iso6392languageCodes"/>
    </dictionaries>

    <rootElement name="mods:mods">
